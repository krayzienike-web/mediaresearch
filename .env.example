DATABASE_URL=postgresql+psycopg://mr:mr@localhost:5432/mediaresearch

# Любая длинная случайная строка, например: python -c "import secrets; print(secrets.token_hex(32))"
# Не меняйте после начала сбора: иначе хэши авторов перестанут совпадать.
AUTHOR_HASH_SALT=change-me

USER_TEXT_RETENTION_DAYS=90

# См. docs/vk-token.md
VK_USER_TOKEN=
VK_SERVICE_TOKEN=
